# Копирайте този файл като .env и попълнете стойностите.

# Админ акаунтът се създава само при първо стартиране (когато базата няма админи).
ADMIN_EMAIL=admin@pchelnakashta.bg
ADMIN_PASSWORD=сменете-ме

# По избор: ключ за подписване на сесиите. Ако липсва, се генерира автоматично в data/jwt-secret.
# JWT_SECRET=

# По избор
# PORT=5000
# DATA_DIR=data
