{
  "name": "pchelna-kashta",
  "version": "1.0.0",
  "private": true,
  "description": "Онлайн магазин за пчеларски продукти с админ панел",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js --port=5000",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning server/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
